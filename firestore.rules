/* ============================================================
   REGLAS DE FIRESTORE — Bubba Games

   Pegar en: consola de Firebase -> Firestore Database -> Reglas
   -> Publicar.

   Tres colecciones, con permisos MUY distintos a propósito:

     players/{uid}      privado. Guarda el progreso completo del
                        jugador. Sólo el dueño lo lee y lo escribe.

     leaderboard/{uid}  público de lectura. Guarda sólo lo que la
                        tabla de posiciones muestra: nombre, foto,
                        saldo, apostado y mejor golpe. Cualquiera
                        lo puede leer; sólo el dueño lo escribe.

     casa/retorno       público de lectura, lo escribe una lista
                        corta. Cuánto paga cada mesa.

   Por qué players y leaderboard están separadas: si el ranking
   leyera de players/, para mostrarlo habría que abrir la lectura de
   TODO el progreso de todos. Un documento aparte con sólo lo que se
   publica es la diferencia entre compartir un dato y filtrar una
   cuenta.
   ============================================================ */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* ====================================================
       QUIÉN ES LA CASA — el único lugar con los uid

       Estaban escritos a mano en tres puntos de este archivo y en
       otros cuatro del repo. Siete copias de un dato que, cuando
       cambia, no falla ruidosamente: simplemente deja de autorizar
       y lo que se ve es un permission-denied sin explicación.

       Van los uid PELADOS de Firebase Auth, sin el 'google:' que el
       casino le pone a sus perfiles. En el código JS el mismo dato
       vive en src/core/roles.js: no se puede compartir una
       constante entre las reglas y el navegador, así que son dos
       lugares, y cada uno apunta al otro.
       ==================================================== */
    function agentes() {
      return ['ZlnbdcBiASbUoEy5vheJBHTIDFg1'];   // nacho
    }
    function agente() {
      return request.auth != null && request.auth.uid in agentes();
    }
    function pedidoValido(p) {
      return p.keys().hasOnly(['id', 'at', 'uid', 'nombre', 'monto', 'nota', 'estado', 'agente'])
        && p.id is string && p.id.size() > 0 && p.id.size() <= 40
        && p.uid == request.auth.uid && p.uid != p.agente
        && p.agente in agentes()
        && p.nombre is string && p.nombre.size() <= 80
        && p.nota is string && p.nota.size() <= 80
        && p.at is int && p.monto is int && p.monto >= 100 && p.monto <= 500000
        && p.estado == 'pendiente';
    }
    function totalAnterior(uid) {
      return exists(/databases/$(database)/documents/fichasRecibidas/$(uid))
        ? get(/databases/$(database)/documents/fichasRecibidas/$(uid)).data.total : 0;
    }
    function transferencia(p) {
      let antes = get(/databases/$(database)/documents/cajasAgentes/$(p.agente)).data;
      let despues = getAfter(/databases/$(database)/documents/cajasAgentes/$(p.agente)).data;
      let fichas = getAfter(/databases/$(database)/documents/fichasRecibidas/$(p.uid)).data;
      return antes.saldo >= p.monto
        && despues.ultimoPedido == p.id && fichas.ultimoPedido == p.id
        && despues.saldo == antes.saldo - p.monto
        && despues.entregado == antes.entregado + p.monto
        && fichas.total == totalAnterior(p.uid) + p.monto;
    }
    function resuelve(antes, despues) {
      return antes.estado == 'pendiente'
        && despues.diff(antes).affectedKeys().hasOnly(['estado', 'resueltaAt'])
        && despues.resueltaAt is int
        && ((request.auth.uid == antes.uid && despues.estado == 'cancelada')
          || (agente() && request.auth.uid == antes.agente
            && despues.estado in ['rechazada', 'aceptada']));
    }

    // Un documento por jugador asegura un unico pedido pendiente entre dispositivos.
    match /pedidosNube/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || agente());
      allow create: if request.auth != null && pedidoValido(request.resource.data)
        && uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/historialPedidos/$(request.resource.data.id)).data == request.resource.data;
      allow update: if request.auth != null
        && getAfter(/databases/$(database)/documents/historialPedidos/$(request.resource.data.id)).data == request.resource.data
        && (resuelve(resource.data, request.resource.data)
          || (uid == request.auth.uid && resource.data.estado != 'pendiente'
            && request.resource.data.id != resource.data.id && pedidoValido(request.resource.data)));
    }
    match /historialPedidos/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || (agente() && resource.data.agente == request.auth.uid));
      allow create: if request.auth != null && pedidoValido(request.resource.data)
        && id == request.resource.data.id
        && getAfter(/databases/$(database)/documents/pedidosNube/$(request.auth.uid)).data == request.resource.data;
      allow update: if request.auth != null && resuelve(resource.data, request.resource.data)
        && (request.resource.data.estado != 'aceptada' || transferencia(resource.data))
        && getAfter(/databases/$(database)/documents/pedidosNube/$(resource.data.uid)).data == request.resource.data;
    }
    match /cajasAgentes/{uid} {
      allow read: if agente() && request.auth.uid == uid;
      allow create: if agente() && request.auth.uid == uid
        && request.resource.data == { 'saldo': 500000, 'entregado': 0, 'ultimoPedido': '' };
      allow update: if agente() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['saldo', 'entregado', 'ultimoPedido'])
        && request.resource.data.saldo is int && request.resource.data.saldo >= 0
        && request.resource.data.entregado is int
        && get(/databases/$(database)/documents/historialPedidos/$(request.resource.data.ultimoPedido)).data.estado == 'pendiente'
        && getAfter(/databases/$(database)/documents/historialPedidos/$(request.resource.data.ultimoPedido)).data.estado == 'aceptada'
        && getAfter(/databases/$(database)/documents/historialPedidos/$(request.resource.data.ultimoPedido)).data.agente == uid;
    }
    match /fichasRecibidas/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || agente());
      allow create, update: if agente()
        && request.resource.data.keys().hasOnly(['total', 'ultimoPedido'])
        && request.resource.data.total is int && request.resource.data.total >= 0
        && get(/databases/$(database)/documents/historialPedidos/$(request.resource.data.ultimoPedido)).data.estado == 'pendiente'
        && getAfter(/databases/$(database)/documents/historialPedidos/$(request.resource.data.ultimoPedido)).data.estado == 'aceptada'
        && getAfter(/databases/$(database)/documents/historialPedidos/$(request.resource.data.ultimoPedido)).data.uid == uid;
    }

    // El progreso de cada jugador: privado.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // La tabla de posiciones: la lee cualquiera, la escribe sólo el dueño.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    /* ========================================================
       EL RETORNO DE LA CASA — casa/retorno

       Cuánto paga cada mesa. Lo lee CUALQUIERA, también quien entra
       sin cuenta: es parte de las reglas del juego, no el dato de
       nadie. Un jugador tiene que poder ver con qué RTP juega.

       Escribirlo es otra cosa: es mover el margen del casino. Sólo
       los uid de la lista de abajo.

       -------- QUIÉN ESTÁ HABILITADO --------
       La lista empezó VACÍA a propósito: hasta que no hubiera un uid
       adentro, nadie podía cambiar el retorno. Mejor eso que
       arrancar abierta y tener que acordarse de cerrarla.

       Para sumar a alguien: su uid lo muestra el panel (Retorno de
       la casa, abajo de todo), y se agrega a agentes(), arriba de
       todo, que es el único lugar de este archivo con uid escritos.
       Después, Consola de Firebase -> Firestore Database -> Reglas
       -> Publicar. Editar este archivo NO alcanza: Firestore lee las
       reglas de la consola, no de GitHub.

       OJO CON EL PREFIJO. El casino guarda sus perfiles como
       'google:ZlnbdcBi...' (auth.js:340 le pone el proveedor
       adelante). Firestore compara contra request.auth.uid, que es
       el uid PELADO de Firebase: 28 caracteres, sin 'google:'. Con
       el prefijo la regla no casa nunca y el error que se ve es un
       permission-denied que no explica nada.

       Ojo con lo que NO valida esta regla: el contenido. Alguien de
       la lista puede escribir cualquier número. No hace falta más:
       la lista son los dueños del casino. Lo que sí se valida es
       que el documento tenga la forma esperada, para que un error
       de tipeo no deje a las mesas sin saber cuánto pagar.
       ======================================================== */
    match /casa/retorno {
      allow read: if true;
      allow write: if agente()
                   && request.resource.data.global is number
                   && request.resource.data.global >= 0.5
                   && request.resource.data.global <= 1
                   && request.resource.data.juegos is map;
    }

    // Todo lo demás cerrado. Si mañana se agrega una colección se le
    // escribe su regla a propósito, y no queda abierta por olvido.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
